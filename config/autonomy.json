{
  "$schema": "../schemas/autonomy.schema.json",
  "schema_version": 1,
  "mode": "operator_triggered_self_sustaining",
  "activation_not_before": "2026-08-05T09:00:00Z",
  "timezone": "Europe/Copenhagen",
  "daily_cycle": {
    "discovery_due_local_hour": 6,
    "snapshot_due_local_hour": 8,
    "window_timezone": "UTC",
    "window_hours": 24,
    "shard_count": 10,
    "region": "ukraine-war",
    "maximum_nonterminal_backlog": 40
  },
  "queue": {
    "proposal_root": "queue/proposals",
    "allowed_proposal_task_types": [
      "extract_observations",
      "investigate_claim",
      "source_profile_review",
      "map_update",
      "daily_report",
      "translate_report",
      "correction",
      "validation"
    ]
  },
  "self_review": {
    "required_rounds": 2,
    "rounds_must_be_separate": true,
    "receipt_root": "review/self",
    "required_checks": [
      "scope",
      "provenance",
      "deduplication",
      "temporal_precision",
      "safety",
      "tests",
      "coverage_gaps"
    ]
  },
  "merge_controller": {
    "enabled": true,
    "strategy": "squash",
    "implementation": "github_actions",
    "validation_workflow": "Validate repository contracts",
    "eligible_head_prefix": "work/task_",
    "worker_direct_merge_allowed": false,
    "administrative_same_repository_controller_allowed": true,
    "human_review_required_for": [
      "source_identity_ambiguity",
      "legal_or_rights_uncertainty",
      "sensitive_geodata_release",
      "released_correction",
      "credential_or_security_boundary_change"
    ]
  },
  "continuous_loop": {
    "command": "continuous loop",
    "aliases": [
      "continuous-loop",
      "копай непрерывно",
      "непрерывный цикл"
    ],
    "atomic_cycle_command": "копай",
    "reconcile_before_each_cycle": true,
    "wait_for_task_merge": true,
    "wait_for_post_merge_finalization": true,
    "refresh_main_after_merge": true,
    "spawned_tasks_are_in_scope": true,
    "exit_only_on_quiescence": true,
    "forced_interruption_is_not_quiescence": true,
    "merge_poll_seconds": 30,
    "idle_poll_seconds": 300,
    "minimum_idle_sweeps": 12,
    "minimum_idle_window_seconds": 3600,
    "scheduled_duty_guard_seconds": 86400
  },
  "branch_cleanup": {
    "owner": "merge_controller",
    "workers_must_not_attempt_connector_deletion": true,
    "failure_is_non_blocking": true,
    "retry_on_reconciliation": true
  },
  "reports": {
    "daily": "automatic",
    "weekly": "on_demand",
    "monthly": "on_demand"
  }
}
