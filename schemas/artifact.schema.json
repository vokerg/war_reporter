{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://war-reporter.invalid/schemas/artifact.schema.json",
  "title": "Evidence artifact manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_id",
    "original_url",
    "retrieved_at",
    "sha256",
    "media_type",
    "size_bytes",
    "access_classification",
    "rights_note"
  ],
  "properties": {
    "artifact_id": {
      "type": "string",
      "pattern": "^art_[a-z0-9][a-z0-9_-]*$"
    },
    "source_item_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^item_[a-z0-9][a-z0-9_-]*$"
    },
    "original_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "archive_url": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri",
      "pattern": "^https://"
    },
    "retrieved_at": {
      "type": "string",
      "format": "date-time"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "media_type": {
      "type": "string",
      "pattern": "^[a-z0-9.+-]+/[a-z0-9.+-]+$"
    },
    "size_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "object_uri": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri"
    },
    "access_classification": {
      "enum": [
        "public",
        "restricted",
        "sensitive",
        "quarantined"
      ]
    },
    "rights_note": {
      "type": "string",
      "minLength": 1
    }
  }
}
