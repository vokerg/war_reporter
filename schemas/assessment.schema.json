{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://war-reporter.invalid/schemas/assessment.schema.json",
  "title": "Editorial assessment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "assessment_id",
    "subject",
    "as_of",
    "conclusion",
    "claim_ids",
    "outcome",
    "confidence",
    "record_status",
    "created_at"
  ],
  "properties": {
    "assessment_id": {
      "type": "string",
      "pattern": "^asm_[a-z0-9][a-z0-9_-]*$"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "enum": [
            "event",
            "region",
            "topic",
            "campaign",
            "claim"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "as_of": {
      "type": "string",
      "format": "date-time"
    },
    "conclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical",
        "language"
      ],
      "properties": {
        "canonical": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "type": "string",
          "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
        },
        "translations": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "claim_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^clm_[a-z0-9][a-z0-9_-]*$"
      },
      "uniqueItems": true
    },
    "outcome": {
      "enum": [
        "confirmed",
        "probable",
        "plausible",
        "unverified",
        "contested",
        "misleading",
        "refuted",
        "mixed"
      ]
    },
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "record_status": {
      "enum": [
        "draft",
        "in_review",
        "approved",
        "rejected",
        "superseded",
        "withdrawn"
      ]
    },
    "supersedes_assessment_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^asm_[a-z0-9][a-z0-9_-]*$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
