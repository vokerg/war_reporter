{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://war-reporter.invalid/schemas/claim.schema.json",
  "title": "Claim",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "claim_id",
    "statement",
    "claim_type",
    "record_status",
    "assessment",
    "evidence",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "claim_id": {
      "type": "string",
      "pattern": "^clm_[a-z0-9][a-z0-9_-]*$"
    },
    "statement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical",
        "language"
      ],
      "properties": {
        "canonical": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "type": "string",
          "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
        },
        "translations": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "claim_type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "record_status": {
      "enum": [
        "draft",
        "in_review",
        "approved",
        "rejected",
        "superseded",
        "withdrawn"
      ]
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "confidence",
        "assessed_at",
        "rationale"
      ],
      "properties": {
        "outcome": {
          "enum": [
            "confirmed",
            "probable",
            "plausible",
            "unverified",
            "contested",
            "misleading",
            "refuted"
          ]
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "assessed_at": {
          "type": "string",
          "format": "date-time"
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "assessor_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "event_time": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "start": {
          "type": "string",
          "format": "date-time"
        },
        "end": {
          "type": "string",
          "format": "date-time"
        },
        "precision": {
          "enum": [
            "second",
            "minute",
            "hour",
            "day",
            "week",
            "month",
            "unknown"
          ]
        }
      },
      "anyOf": [
        {
          "required": [
            "start"
          ]
        },
        {
          "required": [
            "end"
          ]
        }
      ]
    },
    "location_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^loc_[a-z0-9][a-z0-9_-]*$"
      },
      "uniqueItems": true
    },
    "event_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^evt_[a-z0-9][a-z0-9_-]*$"
      },
      "uniqueItems": true
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "observation_id",
          "relation"
        ],
        "properties": {
          "observation_id": {
            "type": "string",
            "pattern": "^obs_[a-z0-9][a-z0-9_-]*$"
          },
          "relation": {
            "enum": [
              "supports",
              "partially_supports",
              "disputes",
              "partially_disputes",
              "contextualizes",
              "corrects",
              "derived_from"
            ]
          }
        }
      }
    },
    "supersedes_claim_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^clm_[a-z0-9][a-z0-9_-]*$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
