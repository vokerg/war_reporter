{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://war-reporter.invalid/schemas/correction.schema.json",
  "title": "Correction",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "correction_id",
    "affected_records",
    "previous_summary",
    "corrected_summary",
    "reason",
    "evidence_observation_ids",
    "published_at",
    "corrected_at",
    "responsible_pr"
  ],
  "properties": {
    "correction_id": {
      "type": "string",
      "pattern": "^corr_[a-z0-9][a-z0-9_-]*$"
    },
    "affected_records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "record_type",
          "record_id"
        ],
        "properties": {
          "record_type": {
            "enum": [
              "source_item",
              "observation",
              "claim",
              "event",
              "assessment",
              "reaction",
              "map_feature",
              "report"
            ]
          },
          "record_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "previous_summary": {
      "type": "string",
      "minLength": 1
    },
    "corrected_summary": {
      "type": "string",
      "minLength": 1
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "evidence_observation_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^obs_[a-z0-9][a-z0-9_-]*$"
      },
      "uniqueItems": true
    },
    "published_at": {
      "type": "string",
      "format": "date-time"
    },
    "corrected_at": {
      "type": "string",
      "format": "date-time"
    },
    "responsible_pr": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "number",
        "url"
      ],
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://github\\.com/[^/]+/[^/]+/pull/[0-9]+$"
        }
      }
    }
  }
}
