{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://war-reporter.invalid/schemas/event.schema.json",
  "title": "Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "title",
    "event_type",
    "claim_ids",
    "record_status",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "pattern": "^evt_[a-z0-9][a-z0-9_-]*$"
    },
    "title": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical",
        "language"
      ],
      "properties": {
        "canonical": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "type": "string",
          "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
        },
        "translations": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "event_type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "event_time": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "start": {
          "type": "string",
          "format": "date-time"
        },
        "end": {
          "type": "string",
          "format": "date-time"
        },
        "precision": {
          "enum": [
            "second",
            "minute",
            "hour",
            "day",
            "week",
            "month",
            "unknown"
          ]
        }
      },
      "anyOf": [
        {
          "required": [
            "start"
          ]
        },
        {
          "required": [
            "end"
          ]
        }
      ]
    },
    "location_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^loc_[a-z0-9][a-z0-9_-]*$"
      },
      "uniqueItems": true
    },
    "claim_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^clm_[a-z0-9][a-z0-9_-]*$"
      },
      "uniqueItems": true
    },
    "record_status": {
      "enum": [
        "draft",
        "in_review",
        "approved",
        "rejected",
        "superseded",
        "withdrawn"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
