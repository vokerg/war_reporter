{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://war-reporter.invalid/schemas/map-feature.schema.json",
  "title": "Map feature",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "id",
    "geometry",
    "properties"
  ],
  "$defs": {
    "position": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        {
          "type": "number"
        }
      ],
      "minItems": 2,
      "maxItems": 3,
      "items": false
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "coordinates"
      ],
      "properties": {
        "type": {
          "const": "Point"
        },
        "coordinates": {
          "$ref": "#/$defs/position"
        }
      }
    },
    "multipoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "coordinates"
      ],
      "properties": {
        "type": {
          "const": "MultiPoint"
        },
        "coordinates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/position"
          }
        }
      }
    },
    "linestring": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "coordinates"
      ],
      "properties": {
        "type": {
          "const": "LineString"
        },
        "coordinates": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/position"
          }
        }
      }
    },
    "multilinestring": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "coordinates"
      ],
      "properties": {
        "type": {
          "const": "MultiLineString"
        },
        "coordinates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 2,
            "items": {
              "$ref": "#/$defs/position"
            }
          }
        }
      }
    },
    "polygon": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "coordinates"
      ],
      "properties": {
        "type": {
          "const": "Polygon"
        },
        "coordinates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 4,
            "items": {
              "$ref": "#/$defs/position"
            }
          }
        }
      }
    },
    "multipolygon": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "coordinates"
      ],
      "properties": {
        "type": {
          "const": "MultiPolygon"
        },
        "coordinates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "array",
              "minItems": 4,
              "items": {
                "$ref": "#/$defs/position"
              }
            }
          }
        }
      }
    }
  },
  "properties": {
    "type": {
      "const": "Feature"
    },
    "id": {
      "type": "string",
      "pattern": "^geo_[a-z0-9][a-z0-9_-]*$"
    },
    "geometry": {
      "oneOf": [
        {
          "$ref": "#/$defs/point"
        },
        {
          "$ref": "#/$defs/multipoint"
        },
        {
          "$ref": "#/$defs/linestring"
        },
        {
          "$ref": "#/$defs/multilinestring"
        },
        {
          "$ref": "#/$defs/polygon"
        },
        {
          "$ref": "#/$defs/multipolygon"
        },
        {
          "type": "null"
        }
      ]
    },
    "properties": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "feature_type",
        "record_status",
        "assessment_outcome",
        "valid_from",
        "assessed_at",
        "publish_not_before",
        "precision_m",
        "uncertainty_method",
        "publication_status",
        "claim_ids",
        "observation_ids"
      ],
      "properties": {
        "feature_type": {
          "enum": [
            "frontline_assessment",
            "territorial_control_assessment",
            "reported_presence",
            "confirmed_presence",
            "strike_report",
            "strike_assessment",
            "explosion_report",
            "damaged_infrastructure",
            "destroyed_infrastructure",
            "evacuation",
            "fortification",
            "bridge_status",
            "crossing",
            "logistics_route",
            "uncertainty_area"
          ]
        },
        "record_status": {
          "enum": [
            "draft",
            "in_review",
            "approved",
            "rejected",
            "superseded",
            "withdrawn"
          ]
        },
        "assessment_outcome": {
          "enum": [
            "confirmed",
            "probable",
            "plausible",
            "unverified",
            "contested",
            "misleading",
            "refuted"
          ]
        },
        "valid_from": {
          "type": "string",
          "format": "date-time"
        },
        "valid_to": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "assessed_at": {
          "type": "string",
          "format": "date-time"
        },
        "publish_not_before": {
          "type": "string",
          "format": "date-time"
        },
        "precision_m": {
          "type": "integer",
          "minimum": 1
        },
        "uncertainty_method": {
          "enum": [
            "source_precision",
            "reported_radius",
            "buffer",
            "generalized",
            "manual_review",
            "unknown"
          ]
        },
        "publication_status": {
          "enum": [
            "public",
            "delayed",
            "coarsened",
            "withheld"
          ]
        },
        "claim_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^clm_[a-z0-9][a-z0-9_-]*$"
          },
          "uniqueItems": true
        },
        "observation_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^obs_[a-z0-9][a-z0-9_-]*$"
          },
          "uniqueItems": true
        },
        "supersedes_feature_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^geo_[a-z0-9][a-z0-9_-]*$"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "properties": {
            "properties": {
              "publication_status": {
                "const": "withheld"
              }
            },
            "required": [
              "publication_status"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "geometry": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "geometry": {
            "oneOf": [
              {
                "$ref": "#/$defs/point"
              },
              {
                "$ref": "#/$defs/multipoint"
              },
              {
                "$ref": "#/$defs/linestring"
              },
              {
                "$ref": "#/$defs/multilinestring"
              },
              {
                "$ref": "#/$defs/polygon"
              },
              {
                "$ref": "#/$defs/multipolygon"
              }
            ]
          }
        }
      }
    }
  ]
}
