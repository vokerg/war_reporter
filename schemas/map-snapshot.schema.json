{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://war-reporter.invalid/schemas/map-snapshot.schema.json",
  "title": "Map snapshot manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "snapshot_id",
    "as_of",
    "generated_at",
    "publication_cutoff",
    "feature_files",
    "claim_set_sha256",
    "record_status"
  ],
  "properties": {
    "snapshot_id": {
      "type": "string",
      "pattern": "^map_[a-z0-9][a-z0-9_-]*$"
    },
    "as_of": {
      "type": "string",
      "format": "date-time"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "publication_cutoff": {
      "type": "string",
      "format": "date-time"
    },
    "feature_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.(?:json|geojson|ndjson)$"
      },
      "uniqueItems": true
    },
    "claim_set_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "record_status": {
      "enum": [
        "draft",
        "in_review",
        "approved",
        "rejected",
        "superseded",
        "withdrawn"
      ]
    },
    "previous_snapshot_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^map_[a-z0-9][a-z0-9_-]*$"
    }
  }
}
