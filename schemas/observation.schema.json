{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://war-reporter.invalid/schemas/observation.schema.json",
  "title": "Observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "observation_id",
    "source_item_id",
    "observation_type",
    "statement",
    "record_status",
    "created_at"
  ],
  "properties": {
    "observation_id": {
      "type": "string",
      "pattern": "^obs_[a-z0-9][a-z0-9_-]*$"
    },
    "source_item_id": {
      "type": "string",
      "pattern": "^item_[a-z0-9][a-z0-9_-]*$"
    },
    "observation_type": {
      "enum": [
        "reported_event",
        "assessment",
        "correction",
        "visual_evidence",
        "official_statement",
        "reaction",
        "methodology_note"
      ]
    },
    "original_excerpt": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "original_language": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
    },
    "quote_locator": {
      "type": [
        "string",
        "null"
      ],
      "description": "Page, paragraph, timestamp, post fragment, or equivalent locator."
    },
    "translations": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "statement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical",
        "language"
      ],
      "properties": {
        "canonical": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "type": "string",
          "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
        },
        "translations": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "speaker_entity_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^src_[a-z0-9][a-z0-9_-]*$"
    },
    "event_time": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "start": {
          "type": "string",
          "format": "date-time"
        },
        "end": {
          "type": "string",
          "format": "date-time"
        },
        "precision": {
          "enum": [
            "second",
            "minute",
            "hour",
            "day",
            "week",
            "month",
            "unknown"
          ]
        }
      },
      "anyOf": [
        {
          "required": [
            "start"
          ]
        },
        {
          "required": [
            "end"
          ]
        }
      ]
    },
    "location_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^loc_[a-z0-9][a-z0-9_-]*$"
      },
      "uniqueItems": true
    },
    "artifact_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^art_[a-z0-9][a-z0-9_-]*$"
      },
      "uniqueItems": true
    },
    "record_status": {
      "enum": [
        "draft",
        "in_review",
        "approved",
        "rejected",
        "superseded",
        "withdrawn"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "original_excerpt": {
            "type": "string"
          }
        },
        "required": [
          "original_excerpt"
        ]
      },
      "then": {
        "required": [
          "original_language",
          "quote_locator"
        ],
        "properties": {
          "original_language": {
            "type": "string",
            "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
          },
          "quote_locator": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "anyOf": [
        {
          "properties": {
            "original_excerpt": {
              "type": "string"
            }
          },
          "required": [
            "original_excerpt"
          ]
        },
        {
          "properties": {
            "artifact_ids": {
              "minItems": 1
            }
          },
          "required": [
            "artifact_ids"
          ]
        }
      ]
    }
  ]
}
