{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://war-reporter.invalid/schemas/raw-manifest.schema.json",
  "title": "Raw discovery manifest",
  "type": "object",
  "additionalProperties": true,
  "required": ["task_id", "worker_run_id", "window", "retrieved_at"],
  "properties": {
    "scan_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "pattern": "^task_[a-z0-9][a-z0-9_-]*$"},
    "worker_run_id": {"type": "string", "pattern": "^run_[a-zA-Z0-9_-]+$"},
    "retrieved_at": {"type": "string", "format": "date-time"},
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": {"type": "string", "format": "date-time"},
        "to": {"type": "string", "format": "date-time"}
      }
    },
    "included_items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["source_item_id"],
        "properties": {
          "source_item_id": {"type": "string", "pattern": "^item_[a-z0-9][a-z0-9_-]*$"}
        }
      }
    },
    "coverage_gaps": {"type": "array", "items": {"type": "string"}},
    "follow_up_task_proposals": {"type": "array", "items": {"type": "object"}}
  }
}
