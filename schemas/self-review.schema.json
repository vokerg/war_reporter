{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://war-reporter.invalid/schemas/self-review.schema.json",
  "title": "Two-round self-review receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "pr_number", "rounds", "exceptional_condition"],
  "properties": {
    "task_id": {"type": "string", "pattern": "^task_[a-z0-9][a-z0-9_-]*$"},
    "pr_number": {"type": "integer", "minimum": 1},
    "rounds": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["round", "reviewed_at", "reviewer_run_id", "checks", "findings", "repairs", "outcome"],
        "properties": {
          "round": {"type": "integer", "minimum": 1, "maximum": 2},
          "reviewed_at": {"type": "string", "format": "date-time"},
          "reviewer_run_id": {"type": "string", "pattern": "^run_[A-Za-z0-9_-]+$"},
          "checks": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "findings": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "repairs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "outcome": {"enum": ["pass", "fail"]}
        }
      }
    },
    "exceptional_condition": {"type": "boolean"},
    "exceptional_reason": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"exceptional_condition": {"const": true}}, "required": ["exceptional_condition"]},
      "then": {"required": ["exceptional_reason"]}
    }
  ]
}
