{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://war-reporter.invalid/schemas/source-item.schema.json",
  "title": "Source item",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_item_id",
    "source_entity_id",
    "canonical_url",
    "published_at",
    "published_at_precision",
    "retrieved_at",
    "language",
    "item_type",
    "content_status",
    "access_method"
  ],
  "properties": {
    "source_item_id": {
      "type": "string",
      "pattern": "^item_[a-z0-9][a-z0-9_-]*$"
    },
    "source_entity_id": {
      "type": "string",
      "pattern": "^src_[a-z0-9][a-z0-9_-]*$"
    },
    "canonical_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "archive_urls": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri",
        "pattern": "^https://"
      },
      "uniqueItems": true
    },
    "platform_item_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "published_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "published_at_precision": {
      "enum": [
        "second",
        "minute",
        "hour",
        "day",
        "unknown"
      ]
    },
    "retrieved_at": {
      "type": "string",
      "format": "date-time"
    },
    "language": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
    },
    "item_type": {
      "enum": [
        "post",
        "article",
        "report",
        "video",
        "audio",
        "image",
        "map",
        "briefing",
        "document",
        "podcast",
        "thread"
      ]
    },
    "title": {
      "type": [
        "string",
        "null"
      ]
    },
    "content_status": {
      "enum": [
        "available",
        "edited",
        "deleted",
        "paywalled",
        "inaccessible",
        "unknown"
      ]
    },
    "access_method": {
      "enum": [
        "public_web",
        "api",
        "rss",
        "manual",
        "archive",
        "other"
      ]
    },
    "upstream_item_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^item_[a-z0-9][a-z0-9_-]*$"
      },
      "uniqueItems": true
    },
    "revision_of_item_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^item_[a-z0-9][a-z0-9_-]*$"
    },
    "artifact_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^art_[a-z0-9][a-z0-9_-]*$"
      },
      "uniqueItems": true
    },
    "content_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    },
    "rights_note": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "published_at": {
            "type": "null"
          }
        },
        "required": [
          "published_at"
        ]
      },
      "then": {
        "properties": {
          "published_at_precision": {
            "const": "unknown"
          }
        }
      }
    }
  ]
}
