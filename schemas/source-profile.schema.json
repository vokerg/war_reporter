{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://war-reporter.invalid/schemas/source-profile.schema.json",
  "title": "Source profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_entity_id",
    "display_name",
    "entity_type",
    "languages",
    "record_status",
    "assessments",
    "updated_at"
  ],
  "properties": {
    "source_entity_id": {
      "type": "string",
      "pattern": "^src_[a-z0-9][a-z0-9_-]*$"
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "entity_type": {
      "enum": [
        "person",
        "organization",
        "outlet",
        "account",
        "channel",
        "official_body",
        "project",
        "unknown"
      ]
    },
    "languages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
      },
      "uniqueItems": true
    },
    "handles": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "websites": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri",
        "pattern": "^https://"
      },
      "uniqueItems": true
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "uniqueItems": true
    },
    "affiliations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "relationship",
          "evidence_urls"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "relationship": {
            "type": "string",
            "minLength": 1
          },
          "valid_from": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "valid_to": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "evidence_urls": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            },
            "uniqueItems": true
          }
        }
      }
    },
    "assessments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "topic",
          "valid_from",
          "dimensions",
          "rationale",
          "reviewed_at",
          "evidence_claim_ids"
        ],
        "properties": {
          "topic": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "valid_from": {
            "type": "string",
            "format": "date"
          },
          "valid_to": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "dimensions": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "identity",
              "access",
              "historical_accuracy",
              "methodology_transparency",
              "correction_behavior",
              "independence"
            ],
            "properties": {
              "identity": {
                "enum": [
                  "high",
                  "medium",
                  "low",
                  "unknown"
                ]
              },
              "access": {
                "enum": [
                  "high",
                  "medium",
                  "low",
                  "unknown"
                ]
              },
              "historical_accuracy": {
                "enum": [
                  "high",
                  "medium",
                  "low",
                  "unknown"
                ]
              },
              "methodology_transparency": {
                "enum": [
                  "high",
                  "medium",
                  "low",
                  "unknown"
                ]
              },
              "correction_behavior": {
                "enum": [
                  "high",
                  "medium",
                  "low",
                  "unknown"
                ]
              },
              "independence": {
                "enum": [
                  "high",
                  "medium",
                  "low",
                  "unknown"
                ]
              }
            }
          },
          "bias_notes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "reviewed_at": {
            "type": "string",
            "format": "date-time"
          },
          "evidence_claim_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^clm_[a-z0-9][a-z0-9_-]*$"
            },
            "uniqueItems": true
          }
        }
      }
    },
    "record_status": {
      "enum": [
        "draft",
        "in_review",
        "approved",
        "rejected",
        "superseded",
        "withdrawn"
      ]
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
