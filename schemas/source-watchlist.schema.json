{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://war-reporter.invalid/schemas/source-watchlist.schema.json",
  "title": "Canonical source watchlist",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "updated_at",
    "effective_from",
    "description",
    "anchor_source_ids",
    "assignment_policy",
    "coverage_policy",
    "source_files"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "effective_from": {
      "type": "string",
      "format": "date-time"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "anchor_source_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^src_[a-z0-9][a-z0-9_-]*$"
      },
      "uniqueItems": true
    },
    "assignment_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "include_priority_tiers",
        "assign_all_active_sources",
        "require_per_source_outcome",
        "allow_unassigned_open_web_discovery"
      ],
      "properties": {
        "include_priority_tiers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "core",
              "extended",
              "opportunistic"
            ]
          },
          "uniqueItems": true
        },
        "assign_all_active_sources": {
          "type": "boolean"
        },
        "require_per_source_outcome": {
          "type": "boolean"
        },
        "allow_unassigned_open_web_discovery": {
          "type": "boolean"
        }
      }
    },
    "coverage_policy": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "min_active_sources",
          "min_core_sources"
        ],
        "properties": {
          "min_active_sources": {
            "type": "integer",
            "minimum": 1
          },
          "min_core_sources": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "source_files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^source-watchlist/sources-[0-9]{2}\\.json$"
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_entity_id",
        "display_name",
        "entity_type",
        "languages",
        "shards",
        "priority_tier",
        "handling_class",
        "topics",
        "collection",
        "identity_evidence_urls",
        "active",
        "reviewed_at"
      ],
      "properties": {
        "source_entity_id": {
          "type": "string",
          "pattern": "^src_[a-z0-9][a-z0-9_-]*$"
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "entity_type": {
          "enum": [
            "person",
            "organization",
            "outlet",
            "account",
            "channel",
            "official_body",
            "project",
            "unknown"
          ]
        },
        "languages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
          },
          "uniqueItems": true
        },
        "shards": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "uniqueItems": true
        },
        "priority_tier": {
          "enum": [
            "core",
            "extended",
            "opportunistic"
          ]
        },
        "handling_class": {
          "enum": [
            "authoritative_for_own_statements",
            "primary_local_reporting",
            "strong_independent_reporting",
            "specialist_analysis",
            "osint_artifact_verification",
            "partisan_signal_only",
            "correction_factcheck",
            "discovery_lead_only"
          ]
        },
        "topics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "uniqueItems": true
        },
        "collection": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "url",
              "cadence",
              "required",
              "access"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "website",
                  "rss",
                  "telegram",
                  "youtube",
                  "podcast",
                  "api",
                  "search"
                ]
              },
              "url": {
                "type": "string",
                "format": "uri",
                "pattern": "^https://"
              },
              "cadence": {
                "enum": [
                  "hourly",
                  "daily",
                  "weekly"
                ]
              },
              "required": {
                "type": "boolean"
              },
              "access": {
                "enum": [
                  "public",
                  "public_preview",
                  "subscription",
                  "index_only"
                ]
              },
              "notes": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "identity_evidence_urls": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "uniqueItems": true
        },
        "active": {
          "type": "boolean"
        },
        "reviewed_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
