{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://war-reporter.invalid/schemas/trust-boundary.schema.json",
  "title": "Worker/reviewer trust boundary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "review_mode",
    "worker_identity",
    "merge_controller_identity",
    "require_distinct_identities",
    "self_approval_allowed",
    "self_merge_allowed"
  ],
  "properties": {
    "review_mode": {"enum": ["administrative", "independent"]},
    "worker_identity": {"type": "string", "minLength": 1},
    "merge_controller_identity": {"type": "string", "minLength": 1},
    "require_distinct_identities": {"type": "boolean"},
    "self_approval_allowed": {"type": "boolean", "const": false},
    "self_merge_allowed": {"type": "boolean", "const": false},
    "notes": {"type": "string", "minLength": 1}
  }
}
